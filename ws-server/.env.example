# HTTP port for the WebSocket server (serves frontend + /ws + /health)
PORT=8080

# Redis connection string (URL format)
REDIS_URL=redis://localhost:6379

# Redis pub/sub channel for satellite positions
# Must match the channel in satellite-worker/.env.example
REDIS_CHANNEL=satellite:positions

# Directory serving the built frontend (relative to ws-server/src/config)
FRONTEND_DIR=../../frontend/dist